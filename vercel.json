{
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "framework": "nextjs",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/ro",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "siteperhour.vercel.app" }],
      "destination": "https://siteperhour.com/$1",
      "permanent": true
    }
  ]
}
